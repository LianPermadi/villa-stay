{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "echo \"Using committed dependencies handled by Vercel PHP runtime\"",
    "buildCommand": "echo \"Using committed public/build assets\"",
    "outputDirectory": "public",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 10
        }
    },
    "routes": [
        {
            "src": "/_diagnostics",
            "dest": "/api/diagnostics.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
